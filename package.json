{
  "name": "linkup",
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun run --filter server start",
    "dev:client": "bun run --filter client dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
